<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Installer.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\AssemblyConverter\FEZ.HAT.AssemblyConverter.csproj" />
    <ProjectReference Include="..\MonoMod\src\MonoMod.Patcher\MonoMod.Patcher.csproj"
                      AdditionalProperties="OutputType=Library;GenerateRuntimeConfigurationFiles=true" />
    <ProjectReference Include="..\MonoMod\src\MonoMod.RuntimeDetour.HookGen\MonoMod.RuntimeDetour.HookGen.csproj"
                      AdditionalProperties="OutputType=Library;GenerateRuntimeConfigurationFiles=true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Installer.txt" LogicalName="Installer.txt" />
    <EmbeddedResource Include="Installer.ico" LogicalName="Installer.ico" />
  </ItemGroup>

  <!-- Build the plugin to produce HAT.zip without referencing its assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\Plugin\FEZ.HAT.mm.csproj" ReferenceOutputAssembly="false">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Rider design-time: resolve ThisAssembly even before HAT.zip exists -->
  <ItemGroup>
    <EmbeddedResource Include="..\Plugin\bin\$(Configuration)\HAT.zip" LogicalName="HAT.zip"
                      Condition="Exists('..\Plugin\bin\$(Configuration)\HAT.zip')"/>
  </ItemGroup>

  <Import Project="ZIPHat.targets"/>
  <Import Project="NETRuntime.targets"/>

</Project>
