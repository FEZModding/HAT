<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HATinstaller</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\Installer.ico</ApplicationIcon>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Expose GitInfo's generated ThisAssembly source to IDE -->
    <UseTemplatedCode>true</UseTemplatedCode>
  </PropertyGroup>

  <Import Project="..\HAT.Version.props" />

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\AssemblyConverter\FEZ.HAT.AssemblyConverter.csproj" />
    <ProjectReference Include="..\MonoMod\src\MonoMod.Patcher\MonoMod.Patcher.csproj"
                      AdditionalProperties="OutputType=Library;GenerateRuntimeConfigurationFiles=true" />
    <ProjectReference Include="..\MonoMod\src\MonoMod.RuntimeDetour.HookGen\MonoMod.RuntimeDetour.HookGen.csproj"
                      AdditionalProperties="OutputType=Library;GenerateRuntimeConfigurationFiles=true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\FNA.dll.config" LogicalName="FNA.dll.config" />
    <EmbeddedResource Include="Resources\OriginalFiles.xml" LogicalName="OriginalFiles.xml" />
    <EmbeddedResource Include="Resources\Steamworks.NET.zip" LogicalName="Steamworks.NET.zip" />
    <EmbeddedResource Include="Resources\MacLauncher.sh" LogicalName="HAT.MacLauncher" />
    <EmbeddedResource Include="Resources\Installer.txt" LogicalName="Installer.txt" />
  </ItemGroup>

  <!-- Build the plugin binaries without referencing its assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\Plugin\FEZ.HAT.mm.csproj" ReferenceOutputAssembly="false">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <Import Project="ZIPHat.targets"/>
  <Import Project="NETRuntime.targets"/>

</Project>
