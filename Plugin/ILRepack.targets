<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="BuildHookBinaries" AfterTargets="RearrangeDependencies" Condition="!Exists('$(TargetDir)FEZ.Hooks.mm.dll')">

    <MakeDir Directories="$(TargetDir)"/>

    <PropertyGroup>
      <HookGenToolDir>$(ProjectDir)..\BuildTools\HookGenTool\bin\$(Configuration)\</HookGenToolDir>
    </PropertyGroup>

    <MSBuild
      Projects="$(ProjectDir)..\BuildTools\HookGenTool\HookGenTool.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration)"
      BuildInParallel="false" />

    <ItemGroup>
      <HookBinaries Include="FEZ.exe" />
      <HookBinaries Include="FezEngine.dll" />
      <HookBinaries Include="FNA.dll" />
    </ItemGroup>
    
    <Exec 
      Command='"$(HookGenToolDir)MonoMod.RuntimeDetour.HookGen.exe" "$(ProjectDir)\Dependencies\%(HookBinaries.Identity)" "$(TargetDir)MMHOOK_%(HookBinaries.Identity)"' 
      WorkingDirectory="$(HookGenToolDir)"
      Condition="'$(OS)' == 'Windows_NT'" />

    <Exec 
      Command='mono "$(HookGenToolDir)MonoMod.RuntimeDetour.HookGen.exe" "$(ProjectDir)/Dependencies/%(HookBinaries.Identity)" "$(TargetDir)MMHOOK_%(HookBinaries.Identity)"' 
      WorkingDirectory="$(HookGenToolDir)"
      Condition="'$(OS)' != 'Windows_NT'" />

    <ItemGroup>
      <GeneratedHookBinaries Include="$(TargetDir)MMHOOK_%(HookBinaries.Identity)"/>
    </ItemGroup>

    <ILRepack 
      Parallel = "True" 
      InputAssemblies = "@(GeneratedHookBinaries)" 
      TargetKind = "Dll" 
      OutputFile = "$(TargetDir)FEZ.Hooks.mm.dll" />

    <Delete Files="@(GeneratedHookBinaries)" />
  </Target>
</Project>
